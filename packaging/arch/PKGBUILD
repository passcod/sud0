# VCS package for the current default branch; release packaging will replace this source.
pkgname=sud0-git
pkgver=0.1.0
pkgrel=1
pkgdesc='Polkit-authorized root command runner'
arch=('x86_64')
url='https://github.com/passcod/sud0'
license=('MIT OR Apache-2.0')
depends=('bash' 'gcc-libs' 'glibc' 'polkit' 'systemd>=257')
makedepends=('git' 'libxml2' 'rust>=1.89')
provides=('sud0')
conflicts=('sud0')
backup=('etc/sud0/prompt.template')
source=('sud0::git+https://github.com/passcod/sud0.git')
b2sums=('SKIP')

pkgver() {
    cd "$srcdir/sud0"
    local base
    base=$(sed -n 's/^version = "\([^"]*\)"/\1/p' Cargo.toml | head -n1)
    printf '%s.r%s.g%s' "$base" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$srcdir/sud0"
    cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
    cd "$srcdir/sud0"
    CARGO_NET_OFFLINE=true make release
}

check() {
    cd "$srcdir/sud0"
    CARGO_NET_OFFLINE=true make check
}

package() {
    cd "$srcdir/sud0"
    make DESTDIR="$pkgdir" PREFIX=/usr install
}
